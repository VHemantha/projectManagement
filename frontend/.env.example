# Copy to .env.local to change. Feature flags are read at build time and are off unless "true".

# Scrum workspaces: Scrum/Kanban choice when creating a workspace, sprint board, Backlog and
# sprint Reports tabs. Off: every workspace (including existing Scrum ones) shows all its jobs
# on a Kanban board; sprint data is kept.
VITE_FEATURE_SCRUM=false

# The workspace Summary tab. Off: ?tab=summary opens the Kanban tab.
VITE_FEATURE_SUMMARY=false
