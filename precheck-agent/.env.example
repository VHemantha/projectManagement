# Copy to .env. Secrets (the API key, the service token, the Google key) belong in the secret
# manager in production, injected as environment variables - never in the repository.

PRECHECK_PM_BASE_URL=http://127.0.0.1:8000
# Must match PRECHECK_SERVICE_TOKEN in the PM application.
PRECHECK_SERVICE_TOKEN=dev-precheck-token

# Models (Claude only). PRECHECK_LLM_MODE=fake is the labelled demo mode: no key needed.
PRECHECK_LLM_MODE=anthropic
PRECHECK_ANTHROPIC_API_KEY=
# The pre-check itself (Opus); images and scans are written out by the reader model; a
# Direction Note is drafted on request by the judge model.
PRECHECK_PRECHECK_MODEL=claude-opus-5-5
PRECHECK_PRECHECK_EFFORT=medium
PRECHECK_READER_MODEL=claude-haiku-4-5-20251001
PRECHECK_JUDGE_MODEL=claude-sonnet-5-5

# Google Drive: a read-only service account. Share each job folder with its email as Viewer.
# PRECHECK_DRIVE_MODE=local reads PRECHECK_LOCAL_DRIVE_ROOT/<folder id> instead.
PRECHECK_DRIVE_MODE=google
PRECHECK_GOOGLE_SERVICE_ACCOUNT_FILE=

# Storage: Postgres with pgvector in production; SQLite for local use.
PRECHECK_DATABASE_URL=sqlite:///./precheck.db
# PRECHECK_DATABASE_URL=postgresql+psycopg://precheck:password@localhost:5432/precheck

# Images and scans are read by the reader model, once per file version. A run reads at most
# this many; the rest are read by the next run.
PRECHECK_BUDGET_IMAGE_CALLS=10
PRECHECK_MAX_SCAN_PAGES=5

# Hard caps on model tokens in one run. The pre-check's input is shortened by code to fit
# PRECHECK_PRECHECK_MAX_INPUT_TOKENS (90000) first, so these are a safety net.
PRECHECK_RUN_INPUT_TOKENS=120000
PRECHECK_RUN_OUTPUT_TOKENS=24000
