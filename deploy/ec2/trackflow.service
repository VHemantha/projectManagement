[Unit]
Description=TrackFlow Django app (gunicorn + uvicorn ASGI workers)
After=network.target redis-server.service postgresql.service
Wants=redis-server.service

[Service]
Type=simple
User=trackflow
Group=trackflow
# `current` is a symlink to the active release; it is resolved at (re)start.
WorkingDirectory=/srv/trackflow/current/backend
# 2 workers fit comfortably in 1 GB RAM. The uvicorn worker speaks both HTTP and
# WebSockets; the Redis channel layer (CHANNEL_LAYER=redis) links the workers.
ExecStart=/srv/trackflow/venv/bin/gunicorn trackflow.asgi:application \
    --worker-class uvicorn_worker.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --graceful-timeout 20 \
    --max-requests 2000 \
    --max-requests-jitter 200
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
