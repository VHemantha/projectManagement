[Unit]
Description=TrackFlow Django app: the web API (gunicorn, threaded WSGI)
After=network.target redis-server.service postgresql.service
Wants=redis-server.service trackflow-ws.service

[Service]
Type=simple
User=trackflow
Group=trackflow
# `current` is a symlink to the active release; it is resolved at (re)start.
WorkingDirectory=/srv/trackflow/current/backend
# Normal page requests. Threaded WSGI, not ASGI: under ASGI Django runs ordinary (sync) views
# one at a time per worker, so one slow request held up everyone. One process with 8 threads
# serves 8 requests at once in about the memory of one worker. WebSockets (live updates, chat)
# are served by trackflow-ws.service.
Environment=DB_CONN_MAX_AGE=60
ExecStart=/srv/trackflow/venv/bin/gunicorn trackflow.wsgi:application \
    --worker-class gthread \
    --workers 1 \
    --threads 8 \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --graceful-timeout 20 \
    --max-requests 2000 \
    --max-requests-jitter 200
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
