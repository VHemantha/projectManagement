SECRET_KEY=django-insecure-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=sqlite
DB_NAME=trackflow
DB_USER=trackflow
DB_PASSWORD=trackflow
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

REALTIME_ENABLED=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production-only settings (the EC2 bootstrap writes these; see DEPLOYMENT.md) ---
# CSRF_TRUSTED_ORIGINS=https://dxxxxxxxx.cloudfront.net
# CHANNEL_LAYER=redis            # required with >1 gunicorn worker (chat WebSockets)
# STATIC_ROOT=/srv/trackflow/shared/static
# MEDIA_ROOT=/srv/trackflow/shared/media
# SECURE_HSTS_SECONDS=0
# LOG_LEVEL=INFO

# --- AI pre-check (the precheck-agent service; see precheck-agent/README.md) ---
# PRECHECK_AGENT_URL=http://127.0.0.1:8100
# PRECHECK_SERVICE_TOKEN=change-me        # same value as the agent's PRECHECK_SERVICE_TOKEN

# --- Email (invitations) ---
# Console by default (emails are printed in the server log). For real delivery, e.g. Amazon SES:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.eu-west-2.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=TrackFlow <no-reply@yourdomain.com>
# FRONTEND_URL=https://dxxxxxxxx.cloudfront.net   # base of invitation links
